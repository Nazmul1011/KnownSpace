{
  "name": "knowspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5340 --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5341 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/flow.e2e.mjs && node tests/e2e/session.e2e.mjs && node tests/e2e/rack.e2e.mjs && node tests/e2e/axe.e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm run test",
    "content:validate": "node scripts/validate-content.mjs",
    "content:icons": "node scripts/gen-icons.mjs",
    "art": "node art/build.mjs",
    "test:responsive": "node tests/responsive/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
